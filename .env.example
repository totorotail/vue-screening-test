# ========================================
# 🌱 Vue 환경 변수 예시 (.env.example)
# 이 파일은 개발자들이 참고해서
# 자신의 .env.development 또는 .env.production 파일을 만들어야 할 때 사용합니다.
#
# 실제 값이 들어있는 .env 파일은 Git에 포함되지 않습니다.
# 이 파일을 복사해서 사용하세요:
#   - 로컬 개발용: .env.development
#   - 배포용: .env.production
# ========================================

# 🔗 API 서버 주소
# Spring Boot 서버가 실행 중인 주소로 설정
# 예시:
#   개발 환경: http://localhost:8080/api/v1
#   운영 환경: https://api.example.com/api/v1

VITE_API_BASE_URL=http://localhost:8080/api/v1